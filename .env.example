# Copy to `.env` and fill in your values (`.env` is gitignored).
# Only variables prefixed with VITE_ are exposed to the browser.

# --- Site ---
VITE_SITE_URL=https://blackrockai.co

# --- Contact ---
VITE_CONTACT_EMAIL=brian@blackrockai.co
# Cal.com or Calendly URL; leave empty to link to the on-page contact section
VITE_BOOKING_URL=

# --- Social (leave blank to keep placeholder # links in the footer) ---
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_X_URL=

# --- Contact form backend (optional — form is frontend-only until set) ---
# Example: https://your-project.supabase.co/functions/v1/contact
VITE_CONTACT_FORM_ENDPOINT=

# --- Supabase (phase 2) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
